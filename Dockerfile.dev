# ─── Development Dockerfile ───────────────────────────────────────────────────
# Used by: docker compose --profile dev up
# Does NOT build the app — runs tsx directly for hot-reload.
# Source code is volume-mounted from the host.
FROM node:20-alpine

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm install --legacy-peer-deps

# Source is mounted at runtime via docker compose volumes,
# so we don't COPY . . here.

EXPOSE 3000 5173

CMD ["npm", "run", "dev"]
